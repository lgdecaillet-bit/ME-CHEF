# Rápido a propósito (< 5 s): solo mira lo que estás commiteando.
# Formatea, arregla lo que puede, y busca secretos en lo staged.
#
# OJO: husky ejecuta este archivo con `sh -e`, que aborta en el primer comando
# que devuelve distinto de cero. Por qué eso importa para gitleaks, y cómo se
# evita que el enganche bloquee sin decir por qué, está en
# scripts/revisar-secretos.sh, que tiene su test.

cd michef && npx lint-staged || exit 1
cd ..

# gitleaks mira el repo; scripts/secrets-bundle.js mira lo que acaba en el
# teléfono. Son cosas distintas y hacen falta las dos. El control vive en su
# propio archivo para poder probarlo (scripts/__tests__/revisar-secretos.test.ts).
sh michef/scripts/revisar-secretos.sh || exit 1
